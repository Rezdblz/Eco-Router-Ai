FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference
ALLOWED_MODELS=

INPUT_PATH=./input/tasks.json
OUTPUT_PATH=./output/results.json
ANALYTICS_PATH=./output/analytics.json
ANALYTICS_HISTORY_DIR=./output/analytics_logs

LOG_LEVEL=INFO

DEFAULT_TEMPERATURE=0.0
MAX_RETRIES=3
REQUEST_TIMEOUT=60

RULE_HIGH_CONFIDENCE=0.95
AI_MIN_CONFIDENCE=0.60

ENVIRONMENT=development